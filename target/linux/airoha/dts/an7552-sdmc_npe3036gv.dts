/dts-v1/;

#include <dt-bindings/leds/common.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "an7552.dtsi"

/ {
	model = "SDMC NPE3036GV";
	compatible = "sdmc,npe3036gv", "airoha,an7552";

	chosen {
		bootargs = "console=ttyS0,115200 earlycon";
		bootargs-append = "rootfstype=squashfs";
		stdout-path = "serial0:115200n8";
		linux,usable-memory-range = <0x80200000 0x1fe00000>;
	};

	aliases {
		serial0 = &uart1;
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-upgrade = &led_power;
		led-running = &led_power;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <100>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pinctrl 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: led@0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <0>;
			gpios = <&pinctrl 27 GPIO_ACTIVE_LOW>;
		};

		xpon_status: led@1 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <1>;
			gpios = <&pinctrl 7 GPIO_ACTIVE_LOW>;
		};

		los: led@2 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			function-enumerator = <2>;
			gpios = <&pinctrl 3 GPIO_ACTIVE_LOW>;
		};

		led@3 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WAN_ONLINE;
			function-enumerator = <3>;
			gpios = <&pinctrl 1 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi0 {
	flash@0 {
		reg = <0>;
		compatible = "spi-nand";
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <2>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bootloader";
				reg = <0x00000000 0x00080000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr: macaddr@7c2d0 {
						compatible = "mac-base";
						reg = <0x7c2d0 0x11>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@80000 {
				label = "tclinux";
				reg = <0x00080000 0x03200000>;
				compatible = "denx,fit-image";
			};

			partition@3280000 {
				label = "tclinux_slave";
				reg = <0x03280000 0x03200000>;
				compatible = "denx,fit-image";
			};

			partition@6480000 {
				label = "rootfs_data";
				reg = <0x06480000 0x03200000>;
			};

			partition@9680000 {
				label = "defaults";
				reg = <0x09680000 0x00800000>;
				read-only;
			};

			partition@9e80000 {
				label = "container";
				reg = <0x09e80000 0x01e00000>;
				read-only;
			};

			partition@dc80000 {
				label = "art";
				reg = <0x0dc80000 0x00380000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom: eeprom@2c0000 {
						reg = <0x2c0000 0x1000>;
					};

					en7571_bob: en7571_bob@260000 {
						reg = <0x260000 0x200>;
					};
				};
			};
		};
	};
};

&usb0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcie1_slot1 {
	reg = <0x00000800 0 0 0 0>;
	#address-cells = <3>;
	#size-cells = <2>;

	mt7916@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <1>;
		#size-cells = <0>;
		nvmem-cells = <&eeprom>;
		nvmem-cell-names = "eeprom";
		airoha,npu = <&npu>;
		airoha,eth = <&eth>;

		band@0 {
			reg = <0>;
			nvmem-cells = <&macaddr 2>;
			nvmem-cell-names = "mac-address";
		};

		band@1 {
			reg = <1>;
			nvmem-cells = <&macaddr 3>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&npu {
	status = "okay";

	firmware-names = "rv32", "data";
	firmware-name = "airoha/an7552_mt7916_npu_rv32.bin",
			"airoha/an7552_mt7916_npu_data.bin";
};

&eth {
	status = "okay";
};

&i2c0 {
	status = "okay";

	en7571: lddla@70 {
		compatible = "airoha,en7571";
		reg = <0x70>;

		nvmem-cells = <&en7571_bob>;
		nvmem-cell-names = "calibration";

		#optical-frontend-cells = <0>;
	};
};

&xpon_phy {
	status = "okay";
};

&xpon {
	status = "okay";

	airoha,gpon-serial-from-mac;
	omci-vendor-id = "SDMC";

	optical-frontends = <&en7571>;
	optical-frontend-names = "pon";

	leds = <&xpon_status>, <&los>;
	led-names = "pon", "los";
};	

&gdm2_pon {
	status = "okay";

	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";

	openwrt,netdev-name = "pon0";
};

&gdm1 {
	status = "okay";
	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";
};

&switch {
	status = "okay";
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_port2 {
	label = "lan2";
	status = "okay";
};

&gsw_port3 {
	label = "lan3";
	status = "okay";
};

&gsw_port4 {
	label = "lan4";
	status = "okay";
};

&gsw_port6 {
	nvmem-cells = <&macaddr 0>;
	nvmem-cell-names = "mac-address";
};

&gsw_phy1 {
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
};

&gsw_phy1_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy2_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy3_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};

&gsw_phy4_led0 {
    status = "okay";
    color = <LED_COLOR_ID_GREEN>;
};
